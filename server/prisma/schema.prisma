// CSSundays database schema. Business rules live in src/services, not here.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

generator pothos {
  provider     = "prisma-pothos-types"
  clientOutput = "./prisma/client.js"
  output       = "../src/generated/pothos-types.ts"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  ORGANIZER
  USER
}

enum AuthTokenKind {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum InviteStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum NotificationType {
  INVITE_TO_TEAM
}

enum TournamentFormat {
  SINGLE_ELIMINATION
}

enum TournamentStatus {
  OPEN_FOR_REGISTRATIONS
  CLOSED_FOR_REGISTRATIONS
  IN_PROGRESS
  FINISHED
}

enum MatchPhase {
  WAITING_FOR_TEAMS
  WAITING_TO_START
  READY_CHECK
  PICK_AND_BAN
  IN_PROGRESS
  FINISHED
  CANCELLED
}

model User {
  id              String    @id @default(uuid()) @db.Uuid
  /// Always stored lower-cased.
  email           String    @unique
  emailVerifiedAt DateTime? @map("email_verified_at")
  passwordHash    String    @map("password_hash")
  playertag       String
  /// Lower-cased playertag for case-insensitive uniqueness and /players/<tag> URLs.
  playertagKey    String    @unique @map("playertag_key")
  description     String    @default("")
  avatarPath      String?   @map("avatar_path")
  steamId         String?   @unique @map("steam_id")
  role            UserRole  @default(USER)
  createdAt       DateTime  @default(now()) @map("created_at")

  sessions           Session[]
  authTokens         AuthToken[]
  ownedTeams         Team[]                   @relation("TeamOwner")
  memberships        TeamMember[]
  sentInvites        TeamInvite[]             @relation("InviteSender")
  receivedInvites    TeamInvite[]             @relation("InviteRecipient")
  notifications      Notification[]
  captaincies        TournamentRegistration[]
  registrations      RegistrationPlayer[]
  chatMessages       MatchChatMessage[]
  bans               MatchBan[]
  createdTournaments Tournament[]

  @@map("users")
}

/// Login sessions. Only a SHA-256 hash of the bearer token is stored.
model Session {
  id        String   @id
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  expiresAt DateTime @map("expires_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

/// One-time links sent by e-mail. Only a SHA-256 hash of the token is stored.
model AuthToken {
  id        String        @id
  userId    String        @map("user_id") @db.Uuid
  kind      AuthTokenKind
  expiresAt DateTime      @map("expires_at")
  createdAt DateTime      @default(now()) @map("created_at")
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("auth_tokens")
}

model Team {
  id         Int      @id @default(autoincrement())
  name       String
  nameKey    String   @unique @map("name_key")
  avatarPath String?  @map("avatar_path")
  ownerId    String   @map("owner_id") @db.Uuid
  wins       Int      @default(0)
  losses     Int      @default(0)
  createdAt  DateTime @default(now()) @map("created_at")

  owner         User                     @relation("TeamOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members       TeamMember[]
  invites       TeamInvite[]
  registrations TournamentRegistration[]

  @@index([ownerId])
  @@map("teams")
}

model TeamMember {
  teamId   Int      @map("team_id")
  userId   String   @map("user_id") @db.Uuid
  joinedAt DateTime @default(now()) @map("joined_at")
  team     Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([teamId, userId])
  @@index([userId])
  @@map("team_members")
}

model TeamInvite {
  id          Int          @id @default(autoincrement())
  teamId      Int          @map("team_id")
  senderId    String       @map("sender_id") @db.Uuid
  recipientId String       @map("recipient_id") @db.Uuid
  status      InviteStatus @default(PENDING)
  createdAt   DateTime     @default(now()) @map("created_at")
  respondedAt DateTime?    @map("responded_at")

  team          Team           @relation(fields: [teamId], references: [id], onDelete: Cascade)
  sender        User           @relation("InviteSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipient     User           @relation("InviteRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  notifications Notification[]

  // A partial unique index (one pending invite per team and player) is added in the migration SQL.
  @@index([recipientId])
  @@map("team_invites")
}

model Notification {
  id          Int              @id @default(autoincrement())
  recipientId String           @map("recipient_id") @db.Uuid
  type        NotificationType
  inviteId    Int?             @map("invite_id")
  seen        Boolean          @default(false)
  createdAt   DateTime         @default(now()) @map("created_at")

  recipient User        @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  invite    TeamInvite? @relation(fields: [inviteId], references: [id], onDelete: Cascade)

  @@index([recipientId, createdAt])
  @@map("notifications")
}

model Tournament {
  id          Int              @id @default(autoincrement())
  name        String
  picturePath String?          @map("picture_path")
  description String           @default("")
  rules       String           @default("")
  format      TournamentFormat @default(SINGLE_ELIMINATION)
  startsAt    DateTime         @map("starts_at")
  /// Always a power of two.
  maxTeams    Int              @map("max_teams")
  status      TournamentStatus @default(OPEN_FOR_REGISTRATIONS)
  published   Boolean          @default(false)
  createdById String?          @map("created_by") @db.Uuid
  createdAt   DateTime         @default(now()) @map("created_at")

  createdBy     User?                    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  registrations TournamentRegistration[]
  players       RegistrationPlayer[]
  matches       Match[]

  @@map("tournaments")
}

model TournamentRegistration {
  id           Int      @id @default(autoincrement())
  tournamentId Int      @map("tournament_id")
  teamId       Int      @map("team_id")
  captainId    String   @map("captain_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  tournament     Tournament           @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  team           Team                 @relation(fields: [teamId], references: [id], onDelete: Cascade)
  captain        User                 @relation(fields: [captainId], references: [id], onDelete: Cascade)
  players        RegistrationPlayer[]
  matchesAsTeam1 Match[]              @relation("Registration1")
  matchesAsTeam2 Match[]              @relation("Registration2")

  @@unique([tournamentId, teamId])
  @@map("tournament_registrations")
}

model RegistrationPlayer {
  registrationId Int      @map("registration_id")
  /// Denormalised so a player can only be registered once per tournament.
  tournamentId   Int      @map("tournament_id")
  userId         String   @map("user_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")

  registration TournamentRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  tournament   Tournament             @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  user         User                   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([registrationId, userId])
  @@unique([tournamentId, userId])
  @@map("registration_players")
}

model GameMap {
  slug      String  @id
  name      String
  imageUrl  String? @map("image_url")
  active    Boolean @default(true)
  sortOrder Int     @default(0) @map("sort_order")

  matches Match[]
  bans    MatchBan[]

  @@map("maps")
}

/// Brackets are complete binary trees with heap numbering: the final is
/// position 1 and the children of position p are 2p (left) and 2p + 1 (right).
model Match {
  id              Int        @id @default(autoincrement())
  tournamentId    Int        @map("tournament_id")
  position        Int
  registration1Id Int?       @map("registration1_id")
  registration2Id Int?       @map("registration2_id")
  phase           MatchPhase @default(WAITING_FOR_TEAMS)
  phaseStartedAt  DateTime   @default(now()) @map("phase_started_at")
  /// Deadline of the current ready check / ban turn.
  phaseEndsAt     DateTime?  @map("phase_ends_at")
  team1Ready      Boolean    @default(false) @map("team1_ready")
  team2Ready      Boolean    @default(false) @map("team2_ready")
  firstBanTeam    Int?       @map("first_ban_team")
  mapSlug         String?    @map("map")
  winner          Int?
  /// Only shown to the two teams and staff.
  serverAddress   String?    @map("server_address")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  tournament    Tournament              @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  registration1 TournamentRegistration? @relation("Registration1", fields: [registration1Id], references: [id], onDelete: SetNull)
  registration2 TournamentRegistration? @relation("Registration2", fields: [registration2Id], references: [id], onDelete: SetNull)
  map           GameMap?                @relation(fields: [mapSlug], references: [slug])
  bans          MatchBan[]
  chatMessages  MatchChatMessage[]

  @@unique([tournamentId, position])
  @@index([phaseEndsAt])
  @@map("matches")
}

model MatchBan {
  id         Int      @id @default(autoincrement())
  matchId    Int      @map("match_id")
  ordinal    Int
  mapSlug    String   @map("map")
  team       Int
  /// Null when the ban was made automatically because the turn timed out.
  bannedById String?  @map("banned_by") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")

  match    Match   @relation(fields: [matchId], references: [id], onDelete: Cascade)
  map      GameMap @relation(fields: [mapSlug], references: [slug])
  bannedBy User?   @relation(fields: [bannedById], references: [id], onDelete: SetNull)

  @@unique([matchId, ordinal])
  @@unique([matchId, mapSlug])
  @@map("match_bans")
}

model MatchChatMessage {
  id        Int      @id @default(autoincrement())
  matchId   Int      @map("match_id")
  senderId  String   @map("sender_id") @db.Uuid
  message   String
  createdAt DateTime @default(now()) @map("created_at")

  match  Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
  sender User  @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([matchId, createdAt])
  @@map("match_chat_messages")
}
