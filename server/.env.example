# Local: `docker compose up -d` in the repo root starts this database.
# Production: the pooled connection string from Neon (…-pooler…neon.tech/…?sslmode=require).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cssundays
# Production only: Neon's direct (non-pooler) connection string, used by `prisma migrate`.
DIRECT_DATABASE_URL=

PORT=4000
# Frontend origin(s), comma separated. Used for CORS, e-mail links and Steam return URLs.
APP_ORIGINS=http://localhost:5173

# E-mail (Resend). Without a key, e-mails are printed to the console instead.
RESEND_API_KEY=
EMAIL_FROM=CSSundays <noreply@cssundays.dk>
# Require a confirmed e-mail before logging in.
REQUIRE_EMAIL_VERIFICATION=false

# Public URL of this API (used for locally stored images). Defaults to http://localhost:PORT.
PUBLIC_API_URL=

# Images. Without S3 settings, files are stored in ./uploads and served by the API.
# Cloudflare R2: endpoint https://<account-id>.r2.cloudflarestorage.com, region auto.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public base URL of the bucket (R2 public bucket URL or custom domain).
IMAGE_BASE_URL=

# Automatic match servers (DatHost). Without these, staff enter server addresses by hand.
# The API creates a new CS2 server for every match and deletes it afterwards.
DATHOST_EMAIL=
DATHOST_PASSWORD=
# Location id for new servers, e.g. copenhagen (https://dathost.readme.io/reference/server-locations-mapping).
DATHOST_LOCATION=
# Production only: the fixed URL DatHost posts results to and a long random secret
# (e.g. `openssl rand -hex 32`). In development webhooks are ignored and results are polled.
DATHOST_WEBHOOK_URL=
DATHOST_WEBHOOK_SECRET=
